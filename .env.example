# Copy to .env for local development. docker-compose reads this file too.

# --- Storage & database ---
MATCHLAB_DATA_DIR=./data
# SQLite for bare-metal dev; compose overrides with postgres
MATCHLAB_DATABASE_URL=sqlite:///./data/matchlab.db

# --- Models ---
# Needed for the real detection stages (roboflow/sports fine-tuned models).
# Leave empty to run with stub stages (configs/pipeline.stub.yaml).
ROBOFLOW_API_KEY=

# --- Worker ---
MATCHLAB_WORKER_POLL_SECONDS=2
MATCHLAB_DEVICE=auto   # auto | cuda | cpu
